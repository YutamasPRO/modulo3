# Cadena de conexión de MongoDB Atlas (o local)
# En MongoDB Atlas: mongodb+srv://<usuario>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=coworking_analytics

# Configuración del pool de conexiones
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_TIMEOUT_MS=5000

# Opcional: Redis para eventos
# REDIS_URL=redis://localhost:6379
